{
  "extends": "nolabs-ai/opencode",
  "meta": {
    "name": "opencode"
  },
  "filesystem": {
    "allow": [],
    "read": [
      "~/.cargo/bin/rtk",
      "~/.nvm/versions/node"
    ],
    "write": [],
    "allow_file": [],
    "read_file": [],
    "write_file": []
  },
  "network": {
    "block": false,
    "allow_http2": false,
    "allow_domain": [
      "127.0.0.1"
    ],
    "connect_port": [
      11434,
      11435
    ],
    "no_proxy": []
  },
  "workdir": {
    "access": "readwrite"
  }
}
