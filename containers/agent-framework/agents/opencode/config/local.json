{
  "$schema": "https://opencode.ai/config.json",
  "model": "llamacpp-engineering/qwen3.5",
  "providers": {
    "llamacpp-engineering": {
      "name": "Local engineering",
      "env": [
        "LOCAL_MODEL_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3.5": {
          "name": "Qwen 3.5 9B Instruct",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "llamacpp-knowledge-base": {
      "name": "Local knowledge base",
      "env": [
        "LOCAL_MODEL_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:11435/v1"
      },
      "models": {
        "ministral": {
          "name": "Ministral 3 8B Instruct",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  }
}
